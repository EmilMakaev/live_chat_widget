# Copy to /etc/live_chat_widget/live_chat_widget.env on the server.
# chmod 640, chown root:live_chat_widget — the app container reads it via
# `env_file:` in docker-compose.yml, and deploy.sh (running as root, but
# invoking `docker compose` as the live_chat_widget group) needs it too.

PHX_SERVER=true
PHX_HOST=chat.example.com
PORT=4000

# `openssl rand -base64 48`
SECRET_KEY_BASE=

# Same password as POSTGRES_PASSWORD below — `db` in the URL is the
# docker-compose service name, not a real hostname; Docker's internal DNS
# resolves it to the `db` container on the compose-managed network.
DATABASE_URL=ecto://live_chat_widget:CHANGE_ME@db/live_chat_widget_prod
POOL_SIZE=10

# Read by the `db` service in docker-compose.yml to create the role/database
# on first boot. Must match the password in DATABASE_URL above.
POSTGRES_PASSWORD=CHANGE_ME

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://chat.example.com
