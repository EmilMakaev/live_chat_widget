# Copy to /etc/live_chat_widget/live_chat_widget.env on the server.
# chmod 600, chown root:root — systemd reads it as root before dropping
# to the live_chat_widget user, so it never needs to be world-readable.

PHX_SERVER=true
PHX_HOST=chat.example.com
PORT=4000

# `openssl rand -base64 48` (or `mix phx.gen.secret` from the release: bin/live_chat_widget eval 'IO.puts(:crypto.strong_rand_bytes(48) |> Base.encode64())')
SECRET_KEY_BASE=

DATABASE_URL=ecto://live_chat_widget:CHANGE_ME@localhost/live_chat_widget_prod
POOL_SIZE=10

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://chat.example.com
