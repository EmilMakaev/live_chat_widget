<Layouts.flash_group flash={@flash} />

<div class="min-h-[80vh] flex items-center justify-center px-4">
  <div class="max-w-md text-center space-y-6">
    <h1 class="text-3xl font-bold">Live Chat Widget</h1>
    <p class="text-gray-500">
      Виджет онлайн-чата для сайта с пересылкой сообщений оператору в Telegram
      и веб-панелью для ответов.
    </p>
    <div class="flex justify-center gap-3">
      <.link navigate={~p"/users/log-in"} class="btn btn-primary">Войти</.link>
      <.link navigate={~p"/users/register"} class="btn btn-ghost">Регистрация</.link>
    </div>
  </div>
</div>
